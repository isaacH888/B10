# Merge with backend/.env.example into backend/.env. Placeholders only.
# Never copy this backend environment to frontend/.env or commit real values.
AUTOMATION_ENABLED=true
AUTOMATION_MODE=local
AUTOMATION_DASHBOARD_URL=http://localhost:5173/admin/bookings
AUTOMATION_OWNER_EMAIL=owner@example.test
AUTOMATION_FROM_EMAIL=orders@example.test
AUTOMATION_CONTRACT_URL=https://example.test/contracts/catering

# Total concurrently reserved/confirmed popsicles across overlapping event intervals.
AUTOMATION_CAPACITY=1000
AUTOMATION_RESERVATION_SECONDS=172800
# Payment reminders are fixed at seven local calendar days. Count timing is independent.
AUTOMATION_COUNT_REMINDER_DAYS=7
AUTOMATION_MAX_ATTEMPTS=6
AUTOMATION_LEASE_SECONDS=120
AUTOMATION_RETRY_BASE_SECONDS=30
AUTOMATION_RETRY_MAX_SECONDS=900

# AWS mode uses the normal SDK credential chain; never put AWS keys in frontend files.
AWS_DEFAULT_REGION=us-east-1
# For local access through an existing named AWS profile, select it explicitly.
# AWS_PROFILE=YOUR_AWS_PROFILE
AUTOMATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/WORK_QUEUE.fifo
AUTOMATION_QUEUE_ARN=arn:aws:sqs:us-east-1:ACCOUNT_ID:WORK_QUEUE.fifo
AUTOMATION_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/DEAD_LETTER_QUEUE.fifo
AUTOMATION_SCHEDULER_GROUP=popssibilities-staging-reminders
AUTOMATION_SCHEDULER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/SCHEDULER_ROLE
AUTOMATION_SCHEDULER_DLQ_ARN=arn:aws:sqs:us-east-1:ACCOUNT_ID:SCHEDULER_DLQ
# Optional Lambda cold-start JSON secret with string-valued DB/auth configuration.
# AUTOMATION_RUNTIME_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:RUNTIME_SECRET

# Client secret JSON shape: {"client_id":"PLACEHOLDER","client_secret":"PLACEHOLDER"}.
# Tokens are encrypted server-side by Secrets Manager. Do not configure raw refresh tokens.
GOOGLE_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:GOOGLE_CLIENT_SECRET
GOOGLE_TOKEN_SECRET_PREFIX=popssibilities/google
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/admin/automation/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Empty creates/reuses a dedicated application-created calendar with calendar.app.created scope.
# A supplied calendar requires calendar.events scope plus writer/owner access.
GOOGLE_EXISTING_CALENDAR_ID=
