# Shared template. Core shell and authentication settings; other adapters remain reserved.
# Copy only the required variables into each component's private environment.
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=America/Chicago

# Public frontend setting. VITE_ values are visible in the browser bundle.
VITE_API_BASE_URL=/api/v1

# Backend settings. Keep all remaining variables out of frontend environments.
APP_SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Approved MySQL foundation; Bryson supplies domain migrations and DB privileges.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=popssibilities_dev
DB_USER=
DB_PASSWORD=
DB_TLS_CA_FILE=

# Local Compose only; never pass the root password to the backend.
MYSQL_ROOT_PASSWORD=

# Customer sample confirmation. Disabled until a dedicated SES sender is configured.
EMAIL_ENABLED=false
EMAIL_PROVIDER=ses
EMAIL_AWS_REGION=us-east-1
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_SES_CONFIGURATION_SET=
# Optional local-only credentials for a separate mailer principal, never the operator.
EMAIL_AWS_ACCESS_KEY_ID=
EMAIL_AWS_SECRET_ACCESS_KEY=
EMAIL_AWS_SESSION_TOKEN=
# Reserved future owner notifications/recipient overrides; unused by customer test mail.
BUSINESS_NOTIFICATION_EMAIL=
EMAIL_SANDBOX_RECIPIENT=

# Choose one Google credential mechanism after the backend design review.
CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Square is first per the recorded Q&A; other providers are later work.
PAYMENT_PROVIDER=square

# External links are configuration, not verified proof of payment.
PAYPAL_PAYMENT_LINK=
SQUARE_PAYMENT_LINK=
VENMO_PAYMENT_LINK=
CONTRACT_URL=

# Scheduling behavior and reminder timing still require client decisions.
REMINDERS_ENABLED=false

# Recorded delivery origin; postal code/geocoding and distance method still need review.
DELIVERY_ORIGIN_ADDRESS="Wingman Kitchens Houston, 4783 Lexington Blvd, Missouri City, TX"
DELIVERY_ORIGIN_POSTAL_CODE=
DISTANCE_PROVIDER=
DISTANCE_API_KEY=
CUSTOM_EVENT_INQUIRY_URL=

# Authentication: separate managed Cognito pools, disabled until configured locally.
AUTH_ENABLED=false
# Set only for a known proxy chain with direct backend access blocked.
AUTH_TRUSTED_PROXY_HOPS=0
AUTH_TOKEN_ENCRYPTION_KEY=
COGNITO_CUSTOMER_ISSUER=
COGNITO_CUSTOMER_CLIENT_ID=
COGNITO_CUSTOMER_CLIENT_SECRET=
COGNITO_CUSTOMER_DOMAIN=
COGNITO_ADMIN_ISSUER=
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_CLIENT_SECRET=
COGNITO_ADMIN_DOMAIN=

# Explicit migration runner only; never needed by the web process.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
